# RAGNAR Ω OMNI — runtime secrets (copy to .env; .env is git-ignored and docker-ignored)
# Generate: openssl rand -hex 32   (or: python3 -c "import secrets; print(secrets.token_hex(32))")
# Fail-closed: without this key the Omega Lock refuses to engage
# (execution denied; drafting still works — by design).
RAGNAR_OMEGA_KEY=change-me-32-plus-random-bytes

# Optional: if set, the API requires X-API-Key on every route (fail-closed).
# RAGNAR_API_KEY=
